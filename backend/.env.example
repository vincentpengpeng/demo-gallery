# 真探·海外涉华信息智能核查平台 - 后端配置
# 复制本文件为 .env 并填入实际值

# ===== 火山引擎 Ark API（LLM）=====
# 必填：在火山引擎方舟控制台创建 API Key
ARK_API_KEY=
# Ark API 地址（默认即可）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID：在方舟控制台"在线推理"中创建接入点后获得，形如 ep-xxxxxx；也可用模型名 doubao-seed-1-6-250615 等
ARK_MODEL=doubao-seed-1-6-250615

# ===== 反向搜图（可选，不填则使用演示数据）=====
# 百度识图（开放平台图像搜索，需申请）
BAIDU_SEARCH_APP_ID=
BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_SECRET_KEY=
# TinEye API（需企业订阅）
TINEYE_API_KEY=

# ===== 联网搜索（可选，不填则使用演示数据）=====
# Brave Search API（免费层 2000 次/月）
BRAVE_API_KEY=

# ===== 数据库 =====
DATABASE_URL=sqlite:///./zhen_tan.db

# ===== 服务 =====
BACKEND_PORT=8000
